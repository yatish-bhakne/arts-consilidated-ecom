{
  "name": "ecom-api",
  "version": "1.0.0",
  "private": true,
  "description": "E-commerce REST API over dummyjson.com/products, backed by MySQL and Elasticsearch",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "seed": "prisma generate && tsx scripts/seed.ts",
    "seed:compiled": "node dist/scripts/seed.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "DATABASE_URL=mysql://ecom:ecom@localhost:3306/ecom ELASTICSEARCH_NODE=http://localhost:9200 LOG_LEVEL=silent vitest run tests/integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.15.0",
    "@prisma/client": "^5.20.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
