# HTTP port the API listens on
PORT=3000

# MySQL connection string consumed by Prisma
# format: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql://ecom:ecom@localhost:3306/ecom

# Elasticsearch node URL
ELASTICSEARCH_NODE=http://localhost:9200

# Name of the Elasticsearch index this service reads/writes products to
ELASTICSEARCH_PRODUCTS_INDEX=products

# Base URL of the dummy data source the seed script fetches from
DUMMYJSON_BASE_URL=https://dummyjson.com

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
